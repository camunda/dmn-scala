<?xml version="1.0" encoding="UTF-8"?>
<definitions id="_0001-input-data-string" name="0001-input-data-string"
	namespace="https://github.com/agilepro/dmn-tck"
	dmnVersion="1.7"
	xmlns="https://www.omg.org/spec/DMN/"
	xmlns:feel="https://www.omg.org/spec/DMN/FEEL/"
	xmlns:dmndi="https://www.omg.org/spec/DMN/DMNDI/"
	xmlns:dc="https://www.omg.org/spec/SCE/DC/">
	<decision name="GreetingMessage" id="greeting">
		<variable name="GreetingMessage" typeRef="feel:string"/>
		<literalExpression expressionLanguage="https://www.omg.org/spec/DMN/FEEL/">
			<text>"Hello " + name</text>
		</literalExpression>
	</decision>
	<dmndi:DMNDI>
		<dmndi:DMNDiagram id="diagram">
			<dmndi:DMNShape id="greeting_di" dmnElementRef="greeting">
				<dc:Bounds x="100" y="100" width="180" height="80"/>
			</dmndi:DMNShape>
		</dmndi:DMNDiagram>
	</dmndi:DMNDI>
</definitions>
